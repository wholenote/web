---
import { categories, cities, prices, recommendations, tiers } from "../data/recommendations";

const defaultCity = cities[0]?.id ?? "";
const defaultTier = tiers[0]?.id ?? "all";
const cityCount = (cityId: string) =>
  recommendations.filter((item) => item.cityId === cityId).length;
const cityItemNumber = (id: string, cityId: string) =>
  recommendations
    .filter((item) => item.cityId === cityId)
    .findIndex((item) => item.id === id) + 1;
---

<section
  class="food-guide section-shell"
  id="field-guide"
  data-food-guide
  data-default-city={defaultCity}
  data-default-tier={defaultTier}
>
  <header class="guide-heading reveal">
    <h1>Restaurant Recommendations</h1>
    <p>My personal picks, no guarantees ◡̈</p>
  </header>

  <div class="guide-toolbar reveal" aria-label="Food guide controls">
    <div class="control-group tier-control">
      <span class="control-label">List</span>
      <div class="chip-row" role="group" aria-label="Choose a recommendation list">
        {tiers.map((tier, index) => (
          <button
            class="filter-chip tier-chip"
            type="button"
            data-tier-button={tier.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {tier.label}
          </button>
        ))}
      </div>
    </div>

    <div class="control-group price-control">
      <span class="control-label">Price</span>
      <div class="chip-row" role="group" aria-label="Filter by price">
        {prices.map((price, index) => (
          <button
            class="filter-chip price-chip"
            type="button"
            data-price-button={price}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {price}
          </button>
        ))}
      </div>
    </div>

    {cities.length > 1 && (
      <div class="control-group city-control">
        <span class="control-label">City</span>
        <div class="chip-row" role="group" aria-label="Choose a city">
          {cities.map((city, index) => (
            <button
              class="filter-chip city-chip"
              type="button"
              data-city-button={city.id}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span>{city.shortName}</span>
              <span class="chip-count" data-city-count={city.id}>{cityCount(city.id)}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="control-group category-control">
      <span class="control-label">Craving</span>
      <div class="chip-row" role="group" aria-label="Filter by category">
        {categories.map((category, index) => (
          <button
            class="filter-chip category-chip"
            type="button"
            data-category-button={category}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="guide-layout reveal">
    <div class="map-card">
      <div class="map-chrome" aria-hidden="true">
        <span class="map-light"></span>
        <span class="map-light"></span>
        <span class="map-light"></span>
        <span class="map-status">LIVE FIELD NOTES</span>
      </div>

      <div class="map-stage">
        <div class="real-map" data-real-map aria-label={`Map of ${cities[0]?.shortName} restaurant recommendations`}></div>
        <div class="map-place-label">
          <strong data-map-city>{cities[0]?.name}</strong>
        </div>
      </div>
    </div>

    <div class="recommendation-panel">
      <div class="panel-heading">
        <span><strong data-result-count>{cityCount(defaultCity)}</strong> places</span>
        <span class="sample-flag" data-edition-label>Austin edition</span>
      </div>

      <div class="recommendation-list" data-recommendation-list aria-live="polite">
        {recommendations.map((item) => (
          <article
            class="recommendation-card"
            data-recommendation={item.id}
            data-city={item.cityId}
            data-category={item.category}
            data-tier={item.tier}
            data-price={item.price}
            hidden={item.cityId !== defaultCity}
          >
            {item.tier === "favorite" && (
              <span class="card-star" aria-label="Brian’s favorite" title="Brian’s favorite">★</span>
            )}
            <button class="card-select" type="button" aria-label={`Show ${item.name} on the map`}>
              <span class="card-index">{String(cityItemNumber(item.id, item.cityId)).padStart(2, "0")}</span>
              <span class="card-copy">
                <span class="card-meta">
                  <span>{item.category}</span>
                  <span>{item.neighborhood}</span>
                  <span>{item.price}</span>
                </span>
                <strong class="card-name">{item.name}</strong>
                <span class="card-note">{item.note}</span>
                {item.order && <span class="card-order"><i>Order this</i>{item.order}</span>}
              </span>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </button>
            {item.directionsUrl && (
              <a class="directions-link" href={item.directionsUrl} target="_blank" rel="noreferrer">
                Directions <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="empty-state" data-empty-state hidden>
        <span aria-hidden="true">◇</span>
        <p>No places match those filters yet.</p>
      </div>
    </div>
  </div>

  <p class="sample-note reveal">
    Restaurant details might not fully up to date because they're added manually.
  </p>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { categoryIcons, cities, recommendations, tiers } from "../data/recommendations";
  import type {
    Recommendation,
    RecommendationPrice,
    RecommendationTier,
  } from "../data/recommendations";

  const guide = document.querySelector<HTMLElement>("[data-food-guide]");
  const mapElement = guide?.querySelector<HTMLElement>("[data-real-map]");
  const defaultCityData = cities[0];

  if (guide && mapElement && defaultCityData) {
    const guideRecommendations: Recommendation[] = recommendations;
    let activeCity = guide.dataset.defaultCity ?? defaultCityData.id;
    let activeTier = (guide.dataset.defaultTier ?? "all") as RecommendationTier | "all";
    let activeCategory = "All";
    let activePrice: RecommendationPrice | "All" = "All";
    let activeRecommendation = "";

    const cityButtons = Array.from(guide.querySelectorAll<HTMLButtonElement>("[data-city-button]"));
    const tierButtons = Array.from(guide.querySelectorAll<HTMLButtonElement>("[data-tier-button]"));
    const categoryButtons = Array.from(guide.querySelectorAll<HTMLButtonElement>("[data-category-button]"));
    const priceButtons = Array.from(guide.querySelectorAll<HTMLButtonElement>("[data-price-button]"));
    const cards = Array.from(guide.querySelectorAll<HTMLElement>("[data-recommendation]"));
    const resultCount = guide.querySelector<HTMLElement>("[data-result-count]");
    const emptyState = guide.querySelector<HTMLElement>("[data-empty-state]");
    const mapCity = guide.querySelector<HTMLElement>("[data-map-city]");
    const editionLabel = guide.querySelector<HTMLElement>("[data-edition-label]");

    const map = L.map(mapElement, {
      attributionControl: true,
      zoomControl: false,
      zoomSnap: 1,
    }).setView([defaultCityData.center.lat, defaultCityData.center.lng], defaultCityData.zoom);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      detectRetina: true,
      maxZoom: 19,
    }).addTo(map);
    L.control.zoom({ position: "bottomright" }).addTo(map);

    const markers = new Map<string, L.Marker>();

    const addMarker = (item: Recommendation) => {
      const icon = L.divIcon({
        className: "restaurant-marker-shell",
        html: `<span class="restaurant-marker"><span class="marker-category-icon" aria-hidden="true">${categoryIcons[item.category]}</span>${item.tier === "favorite" ? '<span class="marker-star" aria-hidden="true">★</span>' : ""}</span>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17],
        tooltipAnchor: [0, -20],
      });
      const marker = L.marker([item.coordinates.lat, item.coordinates.lng], {
        icon,
        keyboard: true,
        title: item.name,
        alt: `${item.name}, ${item.category} in ${item.neighborhood}`,
        riseOnHover: true,
      }).bindTooltip(item.name, { direction: "top", offset: [0, -16] });
      marker.on("click", () => selectRecommendation(item.id, true));
      markers.set(item.id, marker);
    };

    guideRecommendations.forEach(addMarker);

    const fitCity = () => {
      const points = guideRecommendations
        .filter((item) => item.cityId === activeCity
          && (activeTier === "all" || item.tier === activeTier)
          && (activeCategory === "All" || item.category === activeCategory)
          && (activePrice === "All" || item.price === activePrice))
        .map((item) => [item.coordinates.lat, item.coordinates.lng] as L.LatLngTuple);
      if (points.length > 1) {
        map.fitBounds(L.latLngBounds(points), { padding: [42, 42], maxZoom: 12 });
      } else if (points.length === 1) {
        map.setView(points[0]!, 14);
      } else {
        const city = cities.find((item) => item.id === activeCity) ?? defaultCityData;
        map.setView([city.center.lat, city.center.lng], city.zoom);
      }
    };

    const selectRecommendation = (id: string, scrollCard = false) => {
      activeRecommendation = id;

      markers.forEach((marker, markerId) => {
        marker.getElement()?.classList.toggle("is-active", markerId === id && map.hasLayer(marker));
      });

      cards.forEach((card) => {
        const isActive = card.dataset.recommendation === id && !card.hidden;
        card.classList.toggle("is-active", isActive);
        if (isActive && scrollCard) {
          card.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
        }
      });
    };

    const bindCard = (card: HTMLElement) => {
      const selectButton = card.querySelector<HTMLButtonElement>(".card-select");
      const activate = () => selectRecommendation(card.dataset.recommendation ?? "");
      selectButton?.addEventListener("click", activate);
      selectButton?.addEventListener("focus", activate);
      card.addEventListener("pointerenter", activate);
    };

    const updateGuide = (refitMap = false) => {
      const cityCounts = new Map(
        cities.map((city) => [
          city.id,
          guideRecommendations.filter(
            (item) => item.cityId === city.id
              && (activeTier === "all" || item.tier === activeTier),
          ).length,
        ]),
      );
      if ((cityCounts.get(activeCity) ?? 0) === 0) {
        activeCity = cities.find((city) => (cityCounts.get(city.id) ?? 0) > 0)?.id ?? activeCity;
      }

      const cityCategories = new Set<string>(
        guideRecommendations
          .filter((item) => item.cityId === activeCity
            && (activeTier === "all" || item.tier === activeTier))
          .map((item) => item.category),
      );
      if (activeCategory !== "All" && !cityCategories.has(activeCategory)) {
        activeCategory = "All";
      }

      const cityPrices = new Set<string>(
        guideRecommendations
          .filter((item) => item.cityId === activeCity
            && (activeTier === "all" || item.tier === activeTier))
          .map((item) => item.price),
      );
      if (activePrice !== "All" && !cityPrices.has(activePrice)) {
        activePrice = "All";
      }

      tierButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.tierButton === activeTier));
      });
      cityButtons.forEach((button) => {
        const cityId = button.dataset.cityButton ?? "";
        const countValue = cityCounts.get(cityId) ?? 0;
        button.hidden = countValue === 0;
        button.setAttribute("aria-pressed", String(cityId === activeCity));
        const count = button.querySelector<HTMLElement>("[data-city-count]");
        if (count) {
          count.textContent = String(countValue);
        }
      });
      categoryButtons.forEach((button) => {
        const category = button.dataset.categoryButton ?? "All";
        button.hidden = category !== "All" && !cityCategories.has(category);
        button.setAttribute("aria-pressed", String(category === activeCategory));
      });
      priceButtons.forEach((button) => {
        const price = button.dataset.priceButton ?? "All";
        button.hidden = price !== "All" && !cityPrices.has(price);
        button.setAttribute("aria-pressed", String(price === activePrice));
      });

      const city = cities.find((item) => item.id === activeCity) ?? defaultCityData;
      const tier = tiers.find((item) => item.id === activeTier) ?? tiers[0];
      if (mapCity) mapCity.textContent = city.name;
      mapElement.setAttribute("aria-label", `Map of ${city.shortName} restaurant recommendations`);
      if (editionLabel) editionLabel.textContent = `${city.shortName} · ${tier?.label ?? "List"}`;

      const visibleIds: string[] = [];
      cards.forEach((card) => {
        const visible = card.dataset.city === activeCity
          && (activeTier === "all" || card.dataset.tier === activeTier)
          && (activeCategory === "All" || card.dataset.category === activeCategory)
          && (activePrice === "All" || card.dataset.price === activePrice);
        card.hidden = !visible;
        if (visible && card.dataset.recommendation) visibleIds.push(card.dataset.recommendation);
      });

      guideRecommendations.forEach((item) => {
        const marker = markers.get(item.id);
        if (!marker) return;
        const visible = item.cityId === activeCity
          && (activeTier === "all" || item.tier === activeTier)
          && (activeCategory === "All" || item.category === activeCategory)
          && (activePrice === "All" || item.price === activePrice);
        if (visible && !map.hasLayer(marker)) marker.addTo(map);
        if (!visible && map.hasLayer(marker)) marker.removeFrom(map);
      });

      if (resultCount) resultCount.textContent = String(visibleIds.length);
      if (emptyState) emptyState.hidden = visibleIds.length !== 0;

      const nextSelection = visibleIds.includes(activeRecommendation)
        ? activeRecommendation
        : (visibleIds[0] ?? "");
      selectRecommendation(nextSelection);
      if (refitMap) fitCity();
    };

    tierButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeTier = (button.dataset.tierButton ?? activeTier) as RecommendationTier | "all";
        updateGuide(true);
      });
    });

    cityButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCity = button.dataset.cityButton ?? activeCity;
        updateGuide(true);
      });
    });

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.categoryButton ?? "All";
        updateGuide(true);
      });
    });

    priceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activePrice = (button.dataset.priceButton ?? "All") as RecommendationPrice | "All";
        updateGuide(true);
      });
    });

    cards.forEach(bindCard);

    updateGuide(true);
    window.setTimeout(() => map.invalidateSize(), 0);
  }
</script>
