---
interface Props {
  active: "resume" | "food" | "photos";
}

const { active } = Astro.props;
---

<a class="skip-link" href="#main-content">skip to content</a>
<header class="site-header section-shell" id="top" data-site-header>
  <a class="site-name" href={active === "food" ? "#top" : "/food/"} aria-label="made by brian home">
    <img class="site-name-image" src="/favicon-holiday.png?v=59a011f0" alt="" width="44" height="44" />
    <span class="site-name-caption">made by brian</span>
  </a>
  <div class="header-actions">
    <button class="site-menu-toggle" type="button" aria-label="pages menu" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle hidden>
      <span>menu</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <nav class="site-tabs" id="primary-navigation" aria-label="primary navigation">
      <a class="site-tab" href="/resume/" aria-current={active === "resume" ? "page" : undefined}>
        resume
      </a>
      <a class="site-tab" href="/food/" aria-current={active === "food" ? "page" : undefined}>
        food
      </a>
      <span class="site-tab site-tab--unavailable" role="link" aria-disabled="true">
        <span>photos</span><span class="coming-soon-tag">coming soon</span>
      </span>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
    const nav = header.querySelector<HTMLElement>("#primary-navigation")!;
    const actions = header.querySelector<HTMLElement>(".header-actions")!;
    const mobile = window.matchMedia("(max-width: 760px)");

    const setOpen = (open: boolean, returnFocus = false) => {
      const collapsed = mobile.matches && !open;
      if (collapsed && (returnFocus || nav.contains(document.activeElement))) toggle.focus({ preventScroll: true });
      header.dataset.menuOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      nav.inert = collapsed;
    };
    const syncViewport = () => {
      // Make the mobile control available before returning focus to it.
      if (mobile.matches) toggle.hidden = false;
      else {
        nav.inert = false;
        if (document.activeElement === toggle) nav.querySelector<HTMLAnchorElement>("a[aria-current='page'], a[href]")?.focus({ preventScroll: true });
      }
      setOpen(false);
      toggle.hidden = !mobile.matches;
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        event.preventDefault();
        setOpen(false, true);
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    actions.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !actions.contains(event.relatedTarget)) setOpen(false);
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) setOpen(false);
    });
    mobile.addEventListener("change", syncViewport);
    header.dataset.menuEnhanced = "true";
    syncViewport();
  }
</script>
