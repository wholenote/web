---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  active: "resume" | "food" | "photos";
  title: string;
  description: string;
}
const { active, title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0c0b20" />
    <link rel="icon" type="image/png" sizes="104x104" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader active={active} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="guide-footer section-shell">
      <span>Brian</span>
    </footer>
  </body>
</html>
